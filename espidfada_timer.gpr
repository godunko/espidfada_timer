with "config/espidfada_timer_config.gpr";

with "espidfada.gpr";

library project ESPIDFAda_Timer is

   for Languages use ("Ada");
   for Library_Name use "espidfada_timer";
   for Library_Dir use ESPIDFAda.Crate_Library_Dir;
   for Object_Dir use ESPIDFAda.Crate_Object_Dir;
   for Source_Dirs use ("source", ".gens");

   package Compiler extends ESPIDFAda.Compiler is
      for Switches ("Ada")
        use ESPIDFAda_Timer_Config.Ada_Compiler_Switches
        & ESPIDFAda.Compiler_Switches_Ada;
   end Compiler;

end ESPIDFAda_Timer;
